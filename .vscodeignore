.git/**
.github/**
.vscode/**
.vscode-test/**
node_modules/**

# Source and docs (not needed at runtime)
apps/**
packages/**
public/**
docs/**
chrome/**
assets/images/screenshots/**

# Build/config/dev files
src/**
out/**
tests/**
demo-projects/**
tsconfig.json
vite.config.ts
package-lock.json
.gitignore
.env.example
index.html
app.html
metadata.json
netlify.toml
*.vsix

# Keep only runtime artifacts for VS Code extension
!dist/**
!dist-extension/**
!assets/images/icon.png
!README.md
!LICENSE

# Exclude screenshots not used by Help.tsx
dist/assets/*customize-fields*
dist/assets/*kanban-view*
dist/assets/*sidebar-current*
dist/assets/*sidebar-icon*
dist/assets/*start*
dist/assets/*table-view*
