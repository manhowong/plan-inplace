{
  "name": "plan-inplace",
  "displayName": "Plan InPlace",
  "version": "1.2.0",
  "publisher": "manho-wong",
  "description": "Lightweight project planner and todo app with Kanban boards. Git-native project management for developers, local-first and open-source.",
  "author": {
    "name": "Man Ho Wong",
    "url": "https://github.com/manhowong"
  },
  "categories": ["Other"],
  "keywords": ["planner", "project manager", "kanban", "todo", "task"],
  "icon": "assets/images/icon.png",
  "pricing": "Free",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/manhowong/plan-inplace/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manhowong/plan-inplace.git"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/manhowong"
  },
  "homepage": "https://github.com/manhowong/plan-inplace",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:extension": "esbuild apps/vscode/extension.ts --bundle --outfile=dist-extension/extension.cjs --external:vscode --platform=node --format=cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-extension",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist-extension/extension.cjs",
  "activationEvents": [
    "onView:plan-inplace.mainView",
    "onCommand:plan-inplace.open",
    "onCommand:plan-inplace.openMarketplace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "plan-inplace-explorer",
          "title": "Plan InPlace",
          "icon": "assets/images/icon.png"
        }
      ]
    },
    "views": {
      "plan-inplace-explorer": [
        {
          "id": "plan-inplace.mainView",
          "name": "Plan InPlace",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "plan-inplace.open",
        "title": "Open Plan InPlace App",
        "category": "Plan InPlace"
      },
      {
        "command": "plan-inplace.openMarketplace",
        "title": "Open Documentation",
        "category": "Plan InPlace",
        "icon": "$(info)"
      }
    ],
    "keybindings": [
      {
        "command": "plan-inplace.open",
        "key": "shift+alt+p",
        "mac": "shift+alt+p"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "plan-inplace.open"
        },
        {
          "command": "plan-inplace.openMarketplace"
        }
      ],
      "view/title": [
        {
          "command": "plan-inplace.openMarketplace",
          "when": "view == plan-inplace.mainView",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "linkify-react": "^4.3.2",
    "linkifyjs": "^4.3.2"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  }
}
